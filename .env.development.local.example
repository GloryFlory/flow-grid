# DEVELOPMENT DATABASE - SAFE TO RESET
# Copy this to .env.development.local and fill in your dev Supabase project credentials

# Development Supabase Database (CREATE A SEPARATE PROJECT)
DATABASE_URL="postgresql://postgres.[YOUR-DEV-PROJECT-REF]:[YOUR-DEV-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-DEV-PROJECT-REF]:[YOUR-DEV-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Keep all other env vars the same as .env.local
