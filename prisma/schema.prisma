generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  emailVerified          DateTime?
  name                   String?
  avatar                 String?
  password               String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  role                   UserRole             @default(USER)
  hasCompletedOnboarding Boolean              @default(false)
  affiliateCode          String?              @unique
  accounts               Account[]
  analytics              Analytics[]
  festivals              Festival[]
  sessions               Session[]
  subscription           Subscription?
  webAuthnCredentials    WebAuthnCredential[]
  teamMemberships        TeamMember[]
  affiliateReferrals     AffiliateReferral[]  @relation("AffiliateUser")
  referredBy             AffiliateReferral[]  @relation("ReferredUser")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Festival {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  description    String?
  location       String?
  startDate      DateTime
  endDate        DateTime
  timezone       String             @default("UTC")
  logo           String?
  primaryColor   String             @default("#4a90e2")
  secondaryColor String             @default("#7b68ee")
  accentColor    String             @default("#ff6b6b")
  headerFont     String?            // Google Font name for headers (e.g., "Playfair Display", "Oswald")
  customLevelColors Json?           // Custom colors for session levels: { "Beginner": "#22C55E", "Beginner+": "#84CC16", ... }
  hideWatermark  Boolean            @default(false) // Hide "Powered by Flow Grid" (Pro feature)
  isPublished    Boolean            @default(false)
  customDomain   String?            @unique
  userId         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  facebookLink   String?
  instagramLink  String?
  telegramLink   String?
  whatsappLink   String?
  googleSheetUrl String?
  presenterLabel String             @default("Facilitator")
  analytics      Analytics[]
  bookings       Booking[]
  sessions       FestivalSession[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  favourites     SessionFavourite[]
  teachers       Teacher[]
  waitlist       SessionWaitlist[]
  teamMembers    TeamMember[]
  landingPages   LandingPage[]
  subscribers    WebinarSubscriber[]

  @@index([slug, isPublished])
  @@index([userId])
  @@map("festivals")
}

model FestivalSession {
  id              String             @id @default(cuid())
  title           String
  description     String?
  day             String
  startTime       String
  endTime         String
  location        String?
  level           String?
  styles          String[]
  prerequisites   String?
  capacity        Int?
  teachers        String[]
  teacherBios     String[]
  cardType        String             @default("full")
  festivalId      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  displayOrder    Decimal            @default(0)
  bookingCapacity Int?
  bookingEnabled  Boolean            @default(false)
  price           Decimal?
  requirePayment  Boolean            @default(false)
  bookings        Booking[]
  festival        Festival           @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  favourites      SessionFavourite[]
  waitlist        SessionWaitlist[]

  @@index([festivalId, day, startTime])
  @@index([festivalId, displayOrder])
  @@map("festival_sessions")
}

model Booking {
  id         String          @id @default(cuid())
  names      String[]
  email      String?
  deviceId   String
  sessionId  String
  festivalId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  festival   Festival        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  session    FestivalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, deviceId])
  @@index([festivalId])
  @@index([sessionId])
  @@map("bookings")
}

model SessionWaitlist {
  id              String           @id @default(cuid())
  sessionId       String
  festivalId      String
  deviceId        String
  name            String
  email           String
  position        Int              // Queue position (1 = first in line)
  status          WaitlistStatus   @default(WAITING)
  offerToken      String?          @unique // Token for claiming the spot
  offerExpiresAt  DateTime?        // When the offer expires
  offeredAt       DateTime?        // When the offer was sent
  claimedAt       DateTime?        // When they claimed the spot
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  festival        Festival         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  session         FestivalSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, deviceId])
  @@unique([sessionId, email])
  @@index([sessionId, status])
  @@index([offerToken])
  @@map("session_waitlist")
}

enum WaitlistStatus {
  WAITING    // In the queue
  OFFERED    // Spot offered, awaiting claim
  CLAIMED    // Successfully claimed the spot
  EXPIRED    // Offer expired, moved to next person
  CANCELLED  // User cancelled their waitlist spot
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   PlanType           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  festivalsUsed          Int                @default(0)
  festivalsLimit         Int                @default(1)
  isFoundingMember       Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model TeacherPhoto {
  id          String   @id @default(cuid())
  filename    String   @unique
  teacherName String
  teacherId   String?
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_photos")
}

model Teacher {
  id         String         @id @default(cuid())
  festivalId String
  name       String
  url        String?
  isGroup    Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  photos     TeacherPhoto[]
  festival   Festival       @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([festivalId, name])
  @@map("teachers")
}

model Analytics {
  id         String    @id @default(cuid())
  event      String
  properties Json?
  deviceId   String?
  userId     String?
  festivalId String?
  timestamp  DateTime  @default(now())
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model SessionFavourite {
  id         String          @id @default(cuid())
  anonUserId String
  sessionId  String
  festivalId String
  createdAt  DateTime        @default(now())
  festival   Festival        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  session    FestivalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([anonUserId, sessionId])
  @@index([anonUserId])
  @@index([sessionId])
  @@index([festivalId])
  @@map("session_favourites")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model SalesInquiry {
  id                  String        @id @default(cuid())
  name                String
  email               String
  phone               String?
  company             String?
  role                String?
  festivalsPerYear    String?
  typicalFestivalSize String?
  currentSolution     String?
  biggestChallenge    String?
  timeline            String?
  additionalNotes     String?
  status              InquiryStatus @default(NEW)
  source              String?
  meetingBooked       Boolean       @default(false)
  meetingTime         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("sales_inquiries")
}

model TeamMember {
  id         String    @id @default(cuid())
  festivalId String
  userId     String?   // Nullable until invite is accepted
  email      String    // Email of invitee
  role       TeamRole
  inviteToken String?  @unique // Token for accepting invite
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime? // When they accepted the invite
  invitedBy  String    // User ID of who sent the invite
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  festival   Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([festivalId, email]) // Can't invite same email twice to same festival
  @@index([festivalId])
  @@index([userId])
  @@index([inviteToken])
  @@map("team_members")
}

model PaymentRequest {
  id                  String               @id @default(cuid())
  userId              String
  userEmail           String
  userName            String?
  plan                PlanType             // PRO or EVENT_PASS
  billingCycle        BillingCycle?        // MONTHLY, YEARLY, or null for EVENT_PASS
  amount              Decimal
  currency            String               @default("EUR")
  paymentMethod       String               @default("REVOLUT") // For future: BANK_TRANSFER, etc.
  paymentLink         String?              // Revolut payment link used
  transactionRef      String?              // User-provided transaction reference
  verificationStatus  PaymentVerificationStatus @default(PENDING)
  userUpgradedAt      DateTime             @default(now()) // When user was upgraded (instant)
  verifiedAt          DateTime?            // When admin verified payment
  verifiedBy          String?              // Admin user ID who verified
  flaggedAt           DateTime?            // If payment not found
  flaggedBy           String?              // Admin user ID who flagged
  flagReason          String?              // Why payment was flagged
  adminNotes          String?              // Internal notes for admin
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([verificationStatus])
  @@index([userUpgradedAt])
  @@map("payment_requests")
}

enum TeamRole {
  OWNER   // Festival creator, full control
  ADMIN   // Can manage team and all content
  EDITOR  // Can edit sessions/teachers but not manage team
  VIEWER  // Read-only access to admin area
}

enum InquiryStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

enum UserRole {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
  EVENT_PASS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

enum PaymentVerificationStatus {
  PENDING     // Awaiting admin verification (user already upgraded)
  VERIFIED    // Admin confirmed payment received
  FLAGGED     // Admin couldn't find payment (investigate/contact user)
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model LandingPage {
  id               String              @id @default(cuid())
  festivalId       String
  pageType         String              @default("WEBINAR") // WEBINAR | EARLY_BIRD | WAITLIST
  pageSlug         String              @default("webinar") // URL-safe identifier
  title            String              @default("")        // internal name shown in list
  template         String              @default("minimal") // minimal | hero | speaker | countdown
  headline         String
  subheadline      String?
  description      String?
  ctaText          String              @default("Sign me up")
  webinarDate      DateTime?
  webinarEndDate   DateTime?   // optional end of event/early-bird window
  webinarDuration  Int?        // minutes
  speakerName      String?
  speakerTitle     String?
  speakerBio       String?
  speakerPhoto     String?     // URL
  privacyPolicyUrl String?
  webinarLink      String?     // Zoom/Teams/Meet join URL
  isPublished      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  festival         Festival            @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  subscribers      WebinarSubscriber[]

  @@unique([festivalId, pageSlug])
  @@map("landing_pages")
}

model WebinarSubscriber {
  id              String      @id @default(cuid())
  landingPageId   String
  festivalId      String      // kept for easy cross-page querying
  email           String
  firstName       String?
  lastName        String?
  consentAt       DateTime    // GDPR: when consent was given
  consentVersion  String      @default("1.0") // Which T&C version was shown
  consentText     String      // Exact wording shown at signup
  unsubscribeToken String     @unique @default(cuid())
  unsubscribedAt  DateTime?   // Set when they unsubscribe
  ipAddress       String?     // For compliance audit trail (hashed)
  confirmedAt     DateTime?   // Double opt-in confirmation timestamp
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  landingPage     LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  festival        Festival    @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, email])
  @@index([landingPageId])
  @@index([festivalId])
  @@index([unsubscribeToken])
  @@map("webinar_subscribers")
}

model AffiliateReferral {
  id              String          @id @default(cuid())
  affiliateUserId String
  referredUserId  String?
  referredEmail   String?
  conversionType  String?         // PRO | EVENT_PASS
  payoutAmount    Decimal?        // 25.00 or 50.00 EUR
  status          AffiliateStatus @default(SIGNED_UP)
  signedUpAt      DateTime?
  convertedAt     DateTime?
  paidAt          DateTime?
  paidBy          String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  affiliateUser   User            @relation("AffiliateUser", fields: [affiliateUserId], references: [id], onDelete: Cascade)
  referredUser    User?           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@unique([affiliateUserId, referredUserId])
  @@index([affiliateUserId])
  @@index([referredUserId])
  @@index([status])
  @@map("affiliate_referrals")
}

enum AffiliateStatus {
  SIGNED_UP   // Referred user created an account
  CONVERTED   // Referred user bought Pro or Event Pass — payout owed
  PAID        // You've paid the affiliate
}
